{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "srujan2026adf"
		},
		"LS 2026ADLS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS 2026ADLS'"
		},
		"ls_srujan2026adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_srujan2026adls'"
		},
		"LS 2026ADLS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://srujan2026adls.dfs.core.windows.net/"
		},
		"LS SC GIT_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().pm_base_url}"
		},
		"ls_srujan2026adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://srujan2026adls.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "srujan2026adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS 2026ADLS_accountKey": {
						"value": "[parameters('LS 2026ADLS_accountKey')]"
					},
					"ls_srujan2026adls_accountKey": {
						"value": "[parameters('ls_srujan2026adls_accountKey')]"
					},
					"LS 2026ADLS_properties_typeProperties_url": {
						"value": "[parameters('LS 2026ADLS_properties_typeProperties_url')]"
					},
					"LS SC GIT_properties_typeProperties_url": {
						"value": "[parameters('LS SC GIT_properties_typeProperties_url')]"
					},
					"ls_srujan2026adls_properties_typeProperties_url": {
						"value": "[parameters('ls_srujan2026adls_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}